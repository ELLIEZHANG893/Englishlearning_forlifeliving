.hero { text-align: center; padding: 48rpx 0 40rpx; }
.hero-title { font-size: 44rpx; font-weight: 700; }
.hero-sub { color: var(--muted); margin-top: 8rpx; }
.snap { width: 320rpx !important; height: 320rpx; border-radius: 50%; margin: 56rpx auto 32rpx; background: var(--accent); color: #fff; font-size: 36rpx; font-weight: 700; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 16rpx 40rpx rgba(232, 96, 60, 0.35); }
.snap-hover { transform: scale(0.97); }
.snap-icon { font-size: 80rpx; line-height: 1.2; }
.quota { color: var(--muted); font-size: 26rpx; }
.num { color: var(--accent); font-weight: 700; }
.stat { text-align: center; }
.stat-num { font-size: 44rpx; font-weight: 700; }
.accent { color: var(--accent); }
.recent { display: flex; flex-wrap: wrap; justify-content: space-between; }
.recent-item { width: 32%; background: var(--card); border-radius: 20rpx; overflow: hidden; margin-bottom: 20rpx; padding-bottom: 12rpx; text-align: center; }
.recent-img { width: 100%; height: 200rpx; background: var(--line); }
.recent-en { font-weight: 600; margin-top: 8rpx; }
