.center { text-align: center; }
.big { font-size: 96rpx; }
.go { width: 460rpx !important; margin-top: 32rpx; }
.summary { text-align: center; padding-top: 80rpx; }
.sum-title { font-size: 40rpx; font-weight: 700; margin-bottom: 12rpx; }
.progress { display: flex; align-items: center; margin-bottom: 24rpx; }
.bar { flex: 1; height: 12rpx; background: var(--line); border-radius: 999rpx; margin-right: 20rpx; overflow: hidden; }
.bar-in { height: 100%; background: var(--accent); border-radius: 999rpx; transition: width 0.3s; }
.photo { width: 100%; height: 520rpx; border-radius: 20rpx; margin-top: 20rpx; background: var(--line); }
.answer { margin-top: 24rpx; }
.en { font-size: 48rpx; font-weight: 800; }
.speaker { font-size: 32rpx; }
.act { margin-top: 32rpx; }
.rates { display: flex; margin-top: 32rpx; }
.rate { flex: 1; margin: 0 10rpx; border-radius: 999rpx; font-size: 30rpx; font-weight: 600; }
.rate-again { background: #F6E3E0; color: #C0392B; }
.rate-hard { background: #FBF0D9; color: #B7791F; }
.rate-good { background: #E1F3E6; color: #2F855A; }
.listen { display: inline-block; margin-top: 24rpx; padding: 16rpx 40rpx; border-radius: 999rpx; background: var(--accent-soft); color: var(--accent); font-size: 32rpx; }
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.opt-img { width: 48.5%; height: 300rpx; border-radius: 20rpx; overflow: hidden; margin-bottom: 20rpx; border: 6rpx solid transparent; box-sizing: border-box; }
.opt-img image { width: 100%; height: 100%; display: block; }
.opt-text { background: var(--card); border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; font-size: 34rpx; font-weight: 600; text-align: center; border: 4rpx solid transparent; }
.right { border-color: #38A169 !important; background: #E1F3E6; }
.wrong { border-color: #E53E3E !important; background: #F6E3E0; }
.zh-big { font-size: 56rpx; font-weight: 800; margin: 24rpx 0 8rpx; }
