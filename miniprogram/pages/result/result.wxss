.photo-wrap { position: relative; border-radius: 24rpx; overflow: hidden; margin-bottom: 24rpx; }
.photo { width: 100%; display: block; }
.box { position: absolute; border: 4rpx dashed rgba(255, 255, 255, 0.9); border-radius: 12rpx; box-sizing: border-box; }
.box.on { border: 6rpx solid var(--accent); }
.box-label { position: absolute; left: 0; top: 0; background: rgba(0, 0, 0, 0.55); color: #fff; font-size: 22rpx; padding: 2rpx 10rpx; border-bottom-right-radius: 10rpx; }
.box.on .box-label { background: var(--accent); }
.hint { margin-bottom: 16rpx; }
.obj { border: 3rpx solid transparent; }
.obj-on { border-color: var(--accent); }
.obj-en { font-size: 36rpx; font-weight: 700; }
.check { width: 44rpx; height: 44rpx; border-radius: 50%; border: 3rpx solid var(--line); text-align: center; line-height: 40rpx; color: #fff; font-size: 26rpx; }
.check-on { background: var(--accent); border-color: var(--accent); }
.options { margin-top: 16rpx; }
.wrap { flex-wrap: wrap; }
.option { padding: 8rpx 20rpx; border-radius: 999rpx; border: 2rpx solid var(--line); margin: 12rpx 12rpx 0 0; font-size: 26rpx; }
.option-on { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
.save { margin-top: 32rpx; margin-bottom: 16rpx; }
.center { text-align: center; }
